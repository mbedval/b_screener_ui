# PostgreSQL Connection Settings (Local)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=jmbxdbuser
POSTGRES_PASSWORD=jmbxdbpassword
POSTGRES_DB_RAWDATA=bsa_db
POSTGRES_DB_BSA=bsa_db

# Explicit DSN Overrides
RAWDATA_POSTGRES_DSN=postgresql://jmbxdbuser:jmbxdbpassword@127.0.0.1:5432/bsa_db
BSA_POSTGRES_DSN=postgresql://jmbxdbuser:jmbxdbpassword@127.0.0.1:5432/bsa_db

DATABASE_SCHEMA=public
